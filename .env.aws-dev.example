# cp .env.aws-dev.example .env.aws-dev として値を設定します（実値はコミットしません）。
AWS_PROFILE=scholarship-dev
AWS_CONFIG_DIR=/Users/your-name/.aws
AWS_REGION=ap-northeast-1
STORAGE_BACKEND=s3
INGESTION_S3_BUCKET=replace-with-development-bucket
CHAT_KNOWLEDGE_BASE_ID=replace-with-chat-kb-id
CHAT_MODEL_ARN=arn:aws:bedrock:ap-northeast-1::foundation-model/replace-me

# CPFから公開鍵とkidが届いたら設定します。改行は\\nで記載します。
CPF_PUBLIC_KEYS_BY_KID={"cpf-chatbot-stg-202609":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----\\n"}
CPF_FACULTY_RETURN_URL=https://replace-with-cpf-host/faculty/
CPF_STUDENT_RETURN_URL=
CPF_ACCEPTED_ROLES=admin,staff
AUTH_SESSION_TTL_SECONDS=28800

INGESTION_PDF_KNOWLEDGE_BASE_ID=
INGESTION_PDF_DATA_SOURCE_ID=
INGESTION_WEB_KNOWLEDGE_BASE_ID=
INGESTION_WEB_DATA_SOURCE_ID=
INGESTION_EXCEL_KNOWLEDGE_BASE_ID=
INGESTION_EXCEL_DATA_SOURCE_ID=
INGESTION_WORD_KNOWLEDGE_BASE_ID=
INGESTION_WORD_DATA_SOURCE_ID=
INGESTION_PPT_KNOWLEDGE_BASE_ID=
INGESTION_PPT_DATA_SOURCE_ID=
